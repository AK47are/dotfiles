{
  "env": {
    "CLAUDE_CODE_USE_POWERSHELL_TOOL": "1",
    "CLAUDE_CODE_NEW_INIT": "1",
    "DISABLE_INSTALLATION_CHECKS": "1",
    "CLAUDE_CODE_DISABLE_NONSTREAMING_FALLBACK": "1",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1"
  },
  "permissions": {
    "defaultMode": "default"
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -Command \"[System.Console]::Beep()\""
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -Command \"[System.Console]::Beep()\""
          }
        ]
      }
    ]
  },
  "defaultShell": "powershell",
  "enabledPlugins": {
    "nvim-mason-jdtls-lombok-scoop@AK47are": true
  },
  "extraKnownMarketplaces": {
    "AK47are": {
      "source": {
        "source": "directory",
        "path": "~\\.claude\\plugins\\marketplaces\\AK47are"
      }
    }
  },
  "disableAutoMode": "disable",
  "defaultMode": "plan"
}
