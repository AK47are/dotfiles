{
  "env": {
    "CLAUDE_CODE_USE_POWERSHELL_TOOL": "1",
    "CLAUDE_CODE_NEW_INIT": "1",
    "DISABLE_INSTALLATION_CHECKS": "1",
    "CLAUDE_CODE_DISABLE_NONSTREAMING_FALLBACK": "1",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "defaultMode": "plan"
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -Command \"[System.Console]::Beep()\""
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -Command \"[System.Console]::Beep()\""
          }
        ]
      }
    ]
  },
  "defaultShell": "powershell",
  "enabledPlugins": {
    "jdtls-lombok@AK47are": true,
    "frontend-design@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "learning-output-style@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "plugin-dev@claude-plugins-official": true,
    "rtk@AK47are": true,
    "officecli@AK47are": true,
    "gitnexus@gitnexus-marketplace": true,
    "obsidian@obsidian-skills": true,
    "context7@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "AK47are": {
      "source": {
        "source": "directory",
        "path": "~\\.claude\\plugins\\marketplaces\\AK47are"
      }
    },
    "gitnexus-marketplace": {
      "source": {
        "source": "github",
        "repo": "abhigyanpatwari/GitNexus"
      }
    },
    "obsidian-skills": {
      "source": {
        "source": "github",
        "repo": "kepano/obsidian-skills"
      }
    }
  },
  "language": "Simplified Chinese",
  "tui": "fullscreen",
  "disableAutoMode": "disable",
  "preferredNotifChannel": "notifications_disabled",
  "_comment": "gitnexus 需要修改 cache 里的 .mcp.json 配置才能正常连接，最好 npm -g gitnexus 安装配置"
}
